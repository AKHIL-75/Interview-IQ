# PUBLIC build configuration only. Copy to .env.docker, then fill in your values.
# Same Supabase project as backend/.env.docker. Never use a service-role/secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
# Browser API URL is fixed in docker-compose.yml: http://localhost:8000/api/v1

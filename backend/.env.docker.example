# Runtime only: copy to backend/.env.docker. Never pass this as frontend build args.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
# Current auth/persistence uses the caller JWT + anon key; service role is unused.
SUPABASE_SERVICE_ROLE_KEY=
OLLAMA_KEEP_ALIVE=10m
# Enable when the Windows Ollama host should load Qwen at backend startup.
OLLAMA_PREWARM_ENABLED=false
# Optional private Ollama origin, supplied only to the backend.
AWS_OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=120.0
OLLAMA_NUM_PREDICT=300
OLLAMA_THINK=false
LLM_OPERATION_TIMEOUT_S=150
# Compose enforces provider=ollama, model=qwen3:4b, host gateway, exact CORS,
# /api/v1, and an empty OpenRouter key. Do not copy your development .env wholesale.

# Optional Azure Text-to-Speech.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional Azure Speech-to-Text. Configure its resource independently of TTS.
AZURE_STT_SPEECH_KEY=
AZURE_STT_SPEECH_REGION=
AZURE_STT_ENDPOINT=
AZURE_STT_LANGUAGE=en-IN

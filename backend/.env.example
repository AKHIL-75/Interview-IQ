# Interview-IQ Backend Configuration
# Copy this file to .env and adjust values as needed.

# Application Settings
APP_NAME=Interview-IQ Backend
APP_VERSION=1.0.0

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173
# Development aliases; set empty for a single exact production frontend origin.
CORS_EXTRA_ORIGINS=http://127.0.0.1:5173,http://localhost:5174

# API Versioning
API_V1_PREFIX=/api/v1

# --- Phase 3: Ollama / LLM ---
OLLAMA_BASE_URL=http://localhost:11434
AWS_OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=10m
# Optional non-blocking local model preload when the API starts.
OLLAMA_PREWARM_ENABLED=false
OLLAMA_TIMEOUT=120.0
OLLAMA_NUM_PREDICT=300
OLLAMA_THINK=false

# Phase 18: cloud inference is OFF until explicitly selected on the backend.
LLM_PROVIDER=ollama
LLM_OPERATION_TIMEOUT_S=150
# Backend secret: populate only in your ignored backend/.env or process environment.
# Required only when LLM_PROVIDER=openrouter. Never use a VITE_ variable for this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=openrouter/free
# An empty string means no fallback models; do not add paid models for a free test.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_S=45
OPENROUTER_BENCHMARK_ENABLED=false
OPENROUTER_ZDR=true
OPENROUTER_FREE_ONLY=true
# For a free test, set LLM_PROVIDER=openrouter and supply the backend key above.
# To switch back locally, set LLM_PROVIDER=ollama (qwen3:4b settings stay above).
# ZDR/data policy filters can leave no eligible endpoint. They do not independently
# establish every serving provider's retention policy; review the selected endpoint.

# --- Phase 11: Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=



# Azure Neural TTS: use the region from your existing F0 resource's Keys and Endpoint page.
# Leave blank to keep interviewing without question audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure STT uses a SEPARATE Speech resource; never reuse TTS credentials.
# AZURE_STT_ENDPOINT, when needed: HTTPS custom-resource origin, without a path.
# Timeout: min(AZURE_STT_TIMEOUT_S, decoded_duration_seconds + 30).
AZURE_STT_SPEECH_KEY=
AZURE_STT_SPEECH_REGION=
AZURE_STT_ENDPOINT=
AZURE_STT_LANGUAGE=en-IN
AZURE_STT_TIMEOUT_S=630
AZURE_STT_MAX_AUDIO_S=600
AZURE_STT_MAX_CONCURRENCY=1
AZURE_STT_PHRASE_LIST=
